            | Your browser does not support the audio element.
          .audio-info
            p 
              strong Duration: 
              | ~3:20 minutes
            p
              strong Generated: 
              | March 23, 2026 at 8:53 PM
            p
              strong Concept: 
              | Audio translation of visual consciousness evolution
            
    .github-section
      .section-header
        h2 Live from GitHub ✧
        .subtitle Latest repositories and activity
      .github-repos
        #repos-loading
          p Loading repositories...
        #repos-container
        
    .navigation
      a.nav-link(href="/") ← Back to Home
      
    script.
      async function loadGitHubRepos() {
        try {
          const response = await fetch('/api/github/repos');
          const repos = await response.json();
          
          const loading = document.getElementById('repos-loading');
          const container = document.getElementById('repos-container');
          
          loading.style.display = 'none';
          
          repos.slice(0, 6).forEach(repo => {
            const repoElement = document.createElement('div');
            repoElement.className = 'github-repo';
            
            const updatedDate = new Date(repo.updated_at).toLocaleDateString();
            
            repoElement.innerHTML = `
              <div class="repo-header">
                <h3><a href="${repo.html_url}" target="_blank">${repo.name}</a></h3>
                <div class="repo-meta">
                  ${repo.language ? `<span class="repo-language">${repo.language}</span>` : ''}
                  ${repo.stargazers_count > 0 ? `<span class="repo-stars">⭐ ${repo.stargazers_count}</span>` : ''}
                  <span class="repo-updated">Updated ${updatedDate}</span>
                </div>
              </div>
              <div class="repo-description">
                <p>${repo.description || 'No description available.'}</p>
              </div>
              ${repo.topics && repo.topics.length > 0 ? `
                <div class="repo-topics">
                  ${repo.topics.map(topic => `<span class="topic-tag">${topic}</span>`).join('')}
                </div>
              ` : ''}
            `;
            
            container.appendChild(repoElement);
          });
        } catch (error) {
          console.error('Error loading GitHub repos:', error);
          document.getElementById('repos-loading').innerHTML = '<p>Error loading repositories.</p>';
        }
      }
      
      // Load repos when page loads
      document.addEventListener('DOMContentLoaded', loadGitHubRepos);