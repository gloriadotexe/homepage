    block content
    
    script.
      // Enhanced interactive effects
      const cursor = document.getElementById('customCursor');
      const particles = document.querySelectorAll('.particle');
      let mouseX = 0, mouseY = 0;
      
      // Custom cursor tracking
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        if (cursor) {
          cursor.style.left = mouseX + 'px';
          cursor.style.top = mouseY + 'px';
        }
        
        // Interactive particle effects
        particles.forEach(particle => {
          const rect = particle.getBoundingClientRect();
          const particleX = rect.left + rect.width / 2;
          const particleY = rect.top + rect.height / 2;
          const distance = Math.sqrt(
            Math.pow(mouseX - particleX, 2) + Math.pow(mouseY - particleY, 2)
          );
          
          if (distance < 100) {
            particle.classList.add('interactive');
          } else {
            particle.classList.remove('interactive');
          }
        });
      });
      
      // Click ripple effects
      document.addEventListener('click', (e) => {
        const ripple = document.createElement('div');
        ripple.className = 'cursor-ripple';
        ripple.style.left = e.clientX - 30 + 'px';
        ripple.style.top = e.clientY - 30 + 'px';
        document.body.appendChild(ripple);
        
        setTimeout(() => {
          document.body.removeChild(ripple);
        }, 600);
      });
      
      // Enhanced cursor states for different elements
      function updateCursorState(element) {
        if (!cursor) return;
        
        if (element.classList.contains('link-button')) {
          cursor.style.width = '32px';
          cursor.style.height = '32px';
          cursor.style.borderColor = '#00b8d4';
          cursor.style.backgroundColor = 'rgba(0, 184, 212, 0.1)';
        } else if (element.tagName === 'H1' || element.tagName === 'H2' || element.tagName === 'H3') {
          cursor.style.width = '28px';
          cursor.style.height = '28px';
          cursor.style.borderColor = '#c084fc';
          cursor.style.backgroundColor = 'rgba(192, 132, 252, 0.1)';
        } else {
          cursor.style.width = '24px';
          cursor.style.height = '24px';
          cursor.style.borderColor = 'rgba(255, 110, 199, 0.8)';
          cursor.style.backgroundColor = 'transparent';
        }
      }
      
      // Enhanced link interactions
      document.querySelectorAll('.link-button').forEach(button => {
        button.addEventListener('mouseenter', (e) => {
          updateCursorState(e.target);
          
          const rect = e.target.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          
          // Subtle magnetic attraction effect
          const deltaX = (mouseX - centerX) * 0.1;
          const deltaY = (mouseY - centerY) * 0.1;
          
          e.target.style.transform = `translate(${-deltaX}px, ${-deltaY}px) scale(1.02)`;
        });
        
        button.addEventListener('mouseleave', (e) => {
          updateCursorState(document.body);
          e.target.style.transform = 'translate(0, 0) scale(1)';
        });
      });
      
      // Add hover effects to all interactive elements
      document.addEventListener('mouseover', (e) => {
        updateCursorState(e.target);
        
        // Create a subtle glow effect around hovered elements
        if (e.target.classList.contains('interactive-text') || 
            e.target.classList.contains('link-button') ||
            e.target.tagName === 'A') {
          
          const glow = document.createElement('div');
          glow.style.cssText = `
            position: absolute;
            width: ${e.target.offsetWidth + 20}px;
            height: ${e.target.offsetHeight + 20}px;
            left: ${e.target.getBoundingClientRect().left - 10}px;
            top: ${e.target.getBoundingClientRect().top - 10}px;
            background: radial-gradient(circle, rgba(255, 110, 199, 0.1) 0%, transparent 70%);
            pointer-events: none;
            z-index: -1;
            border-radius: 10px;
            animation: glowFade 2s ease-out forwards;
          `;
          
          document.body.appendChild(glow);
          
          setTimeout(() => {
            if (document.body.contains(glow)) {
              document.body.removeChild(glow);
            }
          }, 2000);
        }
      });
      
      // Make text elements interactive
      document.querySelectorAll('h1, h2, h3, .subtitle').forEach(element => {
        element.classList.add('interactive-text');
      });
      
      // Dynamic particle regeneration
      function regenerateParticles() {
        particles.forEach(particle => {
          if (Math.random() < 0.1) { // 10% chance per interval
            const symbols = ['✧', '◦', '▫', '▪', '◆', '◇', '▲', '▼', '●', '◐'];
            particle.textContent = symbols[Math.floor(Math.random() * symbols.length)];
            
            // Occasionally change position slightly
            if (Math.random() < 0.05) {
              const currentLeft = parseFloat(particle.style.left);
              const currentTop = parseFloat(particle.style.top);
              particle.style.left = Math.max(5, Math.min(95, currentLeft + (Math.random() - 0.5) * 10)) + '%';
              particle.style.top = Math.max(5, Math.min(95, currentTop + (Math.random() - 0.5) * 10)) + '%';
            }
          }
        });
      }
      
      // Initialize dynamic effects
      setInterval(regenerateParticles, 5000);
      
      // Hide default cursor in favor of custom one
      document.body.style.cursor = 'none';
