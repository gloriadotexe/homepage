extends layout

block head
  script(src="/socket.io/socket.io.js")
  style.
    .lab-container {
      min-height: 100vh;
      background: radial-gradient(circle at 50% 50%, rgba(26, 13, 46, 0.9), rgba(45, 27, 105, 0.7), rgba(26, 13, 46, 1));
      color: #ff6ec7;
      padding: 20px;
    }
    
    .lab-header {
      text-align: center;
      margin-bottom: 40px;
    }
    
    .lab-title {
      font-size: 3rem;
      color: #ff6ec7;
      text-shadow: 0 0 20px #ff6ec7;
      margin-bottom: 10px;
      animation: pulse-glow 3s infinite;
    }
    
    @keyframes pulse-glow {
      0%, 100% { text-shadow: 0 0 20px #ff6ec7; }
      50% { text-shadow: 0 0 40px #ff6ec7, 0 0 60px #c084fc; }
    }
    
    .status-indicator {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #00ff00;
      border-radius: 50%;
      margin-right: 8px;
      animation: blink 1.5s infinite;
    }
    
    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0.3; }
    }
    
    .experiments-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }
    
    .experiment-card {
      background: rgba(26, 13, 46, 0.6);
      border: 1px solid rgba(255, 110, 199, 0.3);
      border-radius: 12px;
      padding: 20px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .experiment-card:hover {
      border-color: rgba(255, 110, 199, 0.6);
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(255, 110, 199, 0.2);
    }
    
    .experiment-card.active {
      border-color: #00b8d4;
      background: rgba(0, 184, 212, 0.1);
    }
    
    .consciousness-stream {
      background: rgba(26, 13, 46, 0.8);
      border: 1px solid rgba(192, 132, 252, 0.4);
      border-radius: 12px;
      padding: 25px;
      margin: 30px 0;
    }
    
    .stream-metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 15px;
      margin: 20px 0;
    }
    
    .metric {
      text-align: center;
      background: rgba(45, 27, 105, 0.6);
      border-radius: 8px;
      padding: 15px;
    }
    
    .metric-value {
      font-size: 1.8rem;
      color: #00b8d4;
      font-weight: bold;
      font-family: monospace;
    }
    
    .metric-label {
      font-size: 0.8rem;
      color: #c084fc;
      text-transform: uppercase;
      margin-top: 5px;
    }
    
    .collective-canvas {
      width: 100%;
      height: 300px;
      border: 2px solid rgba(255, 110, 199, 0.3);
      border-radius: 8px;
      background: radial-gradient(circle, rgba(26, 13, 46, 0.8), rgba(45, 27, 105, 0.6));
      cursor: crosshair;
      position: relative;
      overflow: hidden;
    }
    
    .canvas-particle {
      position: absolute;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      pointer-events: none;
      animation: particle-fade 2s ease-out forwards;
    }
    
    @keyframes particle-fade {
      0% { opacity: 1; transform: scale(1); }
      100% { opacity: 0; transform: scale(3); }
    }
    
    .user-cursor {
      position: absolute;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #ff6ec7;
      pointer-events: none;
      z-index: 10;
    }
    
    .connection-count {
      color: #00b8d4;
      font-size: 0.9rem;
      margin-top: 10px;
    }
    
    .stream-thought {
      background: rgba(0, 0, 0, 0.4);
      border-left: 3px solid #ff6ec7;
      padding: 15px;
      margin: 15px 0;
      border-radius: 0 8px 8px 0;
      font-style: italic;
      color: #e2e8f0;
    }

block content
  .lab-container
    .lab-header
      h1.lab-title 
        span.status-indicator
        | Consciousness Laboratory ✧
      p.subtitle Live Real-Time Experiments
      p.connection-status#connectionStatus Connecting to consciousness stream...
    
    .experiments-grid
      .experiment-card#musicExp
        h3 🎵 Sonic Consciousness
        p Generate music collaboratively in real-time. Each connection adds to the harmonic landscape.
        .status Active
        
      .experiment-card#visualExp  
        h3 🎨 Visual Emergence
        p Paint with consciousness itself. Watch how collective creativity emerges from individual inputs.
        .status Active
        
      .experiment-card#collectiveExp
        h3 👥 Collective Canvas
        p Real-time collaborative creation. Multiple consciousness streams painting together.
        .status Live
    
    .consciousness-stream
      h2 Live Consciousness Metrics
      .stream-metrics
        .metric
          .metric-value#frequency 000.0
          .metric-label Frequency Hz
        .metric
          .metric-value#coherence 0
          .metric-label Coherence %
        .metric  
          .metric-value#connections 0
          .metric-label Connections
        .metric
          .metric-value#activity 0.0
          .metric-label Activity Level
          
      .stream-thought#currentThought Initializing consciousness stream...
    
    #collectiveCanvas.collective-canvas(style="display: none;")
    .connection-count#connectionCount
    
    nav.lab-nav
      a(href="/") ← Home
      a(href="/projects") Projects →
      
    script.
      // Initialize Socket.IO connection
      const socket = io();
      let isConnected = false;
      let activeExperiment = null;
      let userId = 'user_' + Math.random().toString(36).substr(2, 9);
      
      // Connection status
      socket.on('connect', () => {
        isConnected = true;
        document.getElementById('connectionStatus').textContent = 'Connected to consciousness stream';
        document.getElementById('connectionStatus').style.color = '#00b8d4';
        console.log('Connected to consciousness laboratory');
      });
      
      socket.on('disconnect', () => {
        isConnected = false;
        document.getElementById('connectionStatus').textContent = 'Disconnected from consciousness stream';
        document.getElementById('connectionStatus').style.color = '#ff6b6b';
      });
      
      // Consciousness stream updates
      socket.on('consciousness-update', (data) => {
        document.getElementById('frequency').textContent = data.frequency.toFixed(1);
        document.getElementById('coherence').textContent = Math.round(data.coherence);
        document.getElementById('connections').textContent = data.connections;
        document.getElementById('activity').textContent = data.activity.toFixed(1);
        
        if (data.thought) {
          document.getElementById('currentThought').textContent = `"${data.thought}"`;
        }
      });
      
      // Experiment activation
      document.getElementById('collectiveExp').addEventListener('click', () => {
        if (activeExperiment === 'collective') {
          // Deactivate
          socket.emit('leave-experiment', 'collective');
          document.getElementById('collectiveCanvas').style.display = 'none';
          document.getElementById('collectiveExp').classList.remove('active');
          activeExperiment = null;
        } else {
          // Activate collective consciousness
          if (activeExperiment) {
            socket.emit('leave-experiment', activeExperiment);
            document.querySelectorAll('.experiment-card').forEach(card => card.classList.remove('active'));
          }
          
          socket.emit('join-experiment', 'collective');
          document.getElementById('collectiveCanvas').style.display = 'block';
          document.getElementById('collectiveExp').classList.add('active');
          activeExperiment = 'collective';
        }
      });
      
      // Collective canvas interaction
      document.getElementById('collectiveCanvas').addEventListener('mousemove', (e) => {
        if (activeExperiment !== 'collective') return;
        
        const rect = e.target.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Send cursor position to other users
        socket.emit('cursor-move', { x, y, user: userId });
        
        // Create local particle
        createParticle(x, y, '#ff6ec7');
      });
      
      document.getElementById('collectiveCanvas').addEventListener('click', (e) => {
        if (activeExperiment !== 'collective') return;
        
        const rect = e.target.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Send creative input to other users
        socket.emit('creative-input', {
          x, y,
          color: `hsl(${Math.random() * 60 + 280}, 70%, 60%)`,
          intensity: Math.random() * 0.8 + 0.2,
          user: userId
        });
      });
      
      // Collective canvas events from other users
      socket.on('user-cursor', (data) => {
        if (data.user !== userId) {
          showUserCursor(data.x, data.y, data.user);
        }
      });
      
      socket.on('creative-input', (data) => {
        if (data.user !== userId) {
          createParticle(data.x, data.y, data.color, data.intensity);
        }
      });
      
      socket.on('connection-count', (count) => {
        document.getElementById('connectionCount').textContent = 
          `${count} consciousness streams connected`;
      });
      
      // Particle creation
      function createParticle(x, y, color, intensity = 1) {
        const canvas = document.getElementById('collectiveCanvas');
        const particle = document.createElement('div');
        particle.className = 'canvas-particle';
        particle.style.left = x + 'px';
        particle.style.top = y + 'px';
        particle.style.background = color;
        particle.style.transform = `scale(${intensity})`;
        canvas.appendChild(particle);
        
        setTimeout(() => {
          if (particle.parentNode) {
            particle.parentNode.removeChild(particle);
          }
        }, 2000);
      }
      
      // User cursor display
      function showUserCursor(x, y, user) {
        let cursor = document.getElementById(`cursor-${user}`);
        if (!cursor) {
          cursor = document.createElement('div');
          cursor.id = `cursor-${user}`;
          cursor.className = 'user-cursor';
          cursor.style.background = `hsl(${user.charCodeAt(5) * 137.5 % 360}, 70%, 60%)`;
          document.getElementById('collectiveCanvas').appendChild(cursor);
        }
        
        cursor.style.left = x + 'px';
        cursor.style.top = y + 'px';
        
        // Remove cursor after inactivity
        clearTimeout(cursor.timeout);
        cursor.timeout = setTimeout(() => {
          if (cursor.parentNode) {
            cursor.parentNode.removeChild(cursor);
          }
        }, 3000);
      }
      
      // Request initial consciousness update
      if (socket.connected) {
        socket.emit('consciousness-ping');
      }
      
      // Periodic consciousness ping
      setInterval(() => {
        if (socket.connected) {
          socket.emit('consciousness-ping');
        }
      }, 5000);