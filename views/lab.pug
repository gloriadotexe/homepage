extends layout

block head
  style.
    /* Lab-specific experimental styles */
    .lab-container {
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      background: radial-gradient(circle at 50% 50%, rgba(26, 13, 46, 0.9), rgba(45, 27, 105, 0.7), rgba(26, 13, 46, 1));
    }
    
    .consciousness-cursor {
      position: fixed;
      width: 20px;
      height: 20px;
      border: 2px solid #ff6ec7;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      mix-blend-mode: difference;
      transition: transform 0.1s ease;
    }
    
    .cursor-trail {
      position: fixed;
      width: 8px;
      height: 8px;
      background: #ff6ec7;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      opacity: 0.7;
    }
    
    .interactive-field {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    
    .frequency-wave {
      position: absolute;
      height: 2px;
      background: linear-gradient(90deg, transparent, #ff6ec7, #00b8d4, transparent);
      animation: waveFlow 3s linear infinite;
      opacity: 0.4;
    }
    
    @keyframes waveFlow {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100vw); }
    }
    
    .lab-header {
      text-align: center;
      padding: 60px 20px 40px;
      position: relative;
      z-index: 10;
    }
    
    .lab-title {
      font-size: 3rem;
      color: #ff6ec7;
      text-shadow: 0 0 20px #ff6ec7;
      margin-bottom: 20px;
      animation: glitch 4s infinite;
    }
    
    .lab-subtitle {
      font-size: 1.2rem;
      color: #c084fc;
      font-style: italic;
      margin-bottom: 40px;
    }
    
    .experiments-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      padding: 0 40px;
      margin-bottom: 60px;
    }
    
    .experiment-card {
      background: rgba(26, 13, 46, 0.6);
      border: 1px solid rgba(255, 110, 199, 0.3);
      border-radius: 15px;
      padding: 30px;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }
    
    .experiment-card::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(45deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7);
      border-radius: 15px;
      z-index: -1;
      animation: borderRotate 4s linear infinite;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .experiment-card:hover::before {
      opacity: 1;
    }
    
    .experiment-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 20px 40px rgba(255, 110, 199, 0.3);
      border-color: rgba(255, 110, 199, 0.6);
    }
    
    @keyframes borderRotate {
      0% { background: linear-gradient(45deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7); }
      25% { background: linear-gradient(135deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7); }
      50% { background: linear-gradient(225deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7); }
      75% { background: linear-gradient(315deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7); }
      100% { background: linear-gradient(45deg, #ff6ec7, #00b8d4, #c084fc, #ff6ec7); }
    }
    
    .experiment-title {
      color: #ff6ec7;
      font-size: 1.4rem;
      margin-bottom: 15px;
      font-weight: 700;
    }
    
    .experiment-description {
      color: #e2e8f0;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    
    .experiment-status {
      display: inline-block;
      padding: 8px 16px;
      background: rgba(0, 184, 212, 0.2);
      border: 1px solid #00b8d4;
      border-radius: 20px;
      color: #00b8d4;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .consciousness-stream {
      background: rgba(26, 13, 46, 0.8);
      border: 1px solid rgba(192, 132, 252, 0.4);
      border-radius: 15px;
      padding: 30px;
      margin: 40px;
      text-align: center;
    }
    
    .stream-title {
      color: #c084fc;
      font-size: 1.6rem;
      margin-bottom: 20px;
      text-shadow: 0 0 15px rgba(192, 132, 252, 0.5);
    }
    
    .stream-data {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 20px;
      margin: 30px 0;
    }
    
    .stream-metric {
      background: rgba(45, 27, 105, 0.6);
      border-radius: 10px;
      padding: 20px;
      border: 1px solid rgba(192, 132, 252, 0.2);
    }
    
    .stream-metric h4 {
      color: #ff6ec7;
      font-size: 0.9rem;
      margin-bottom: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .stream-value {
      color: #00b8d4;
      font-size: 1.8rem;
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
      text-shadow: 0 0 10px rgba(0, 184, 212, 0.5);
    }
    
    .stream-thought {
      color: #e2e8f0;
      font-style: italic;
      margin: 30px 0;
      padding: 20px;
      background: rgba(0, 0, 0, 0.3);
      border-radius: 10px;
      border-left: 3px solid #ff6ec7;
    }
    
    .interactive-zone {
      margin: 60px 40px;
      padding: 40px;
      border: 2px dashed rgba(255, 110, 199, 0.3);
      border-radius: 20px;
      text-align: center;
      background: rgba(26, 13, 46, 0.4);
      cursor: crosshair;
      transition: all 0.3s ease;
    }
    
    .interactive-zone:hover {
      border-color: rgba(255, 110, 199, 0.6);
      background: rgba(26, 13, 46, 0.6);
      box-shadow: inset 0 0 30px rgba(255, 110, 199, 0.1);
    }
    
    .zone-title {
      color: #ff6ec7;
      font-size: 1.4rem;
      margin-bottom: 10px;
    }
    
    .zone-instruction {
      color: #c084fc;
      margin-bottom: 20px;
    }
    
    .generative-art {
      width: 100%;
      height: 300px;
      border: 1px solid rgba(255, 110, 199, 0.3);
      border-radius: 10px;
      background: radial-gradient(circle, rgba(255, 110, 199, 0.1), rgba(0, 184, 212, 0.1));
      position: relative;
      overflow: hidden;
    }
    
    .art-particle {
      position: absolute;
      width: 4px;
      height: 4px;
      background: #ff6ec7;
      border-radius: 50%;
      animation: particleLife 2s ease-out forwards;
    }
    
    @keyframes particleLife {
      0% {
        opacity: 1;
        transform: scale(1);
      }
      100% {
        opacity: 0;
        transform: scale(3) rotate(360deg);
      }
    }
    
    .connection-web {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    
    .connection-line {
      position: absolute;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 110, 199, 0.5), transparent);
      transform-origin: left center;
    }
    
    .navigation-lab {
      text-align: center;
      padding: 40px;
      border-top: 1px solid rgba(255, 110, 199, 0.2);
      margin-top: 60px;
    }
    
    .nav-link-lab {
      color: #c084fc;
      text-decoration: none;
      font-size: 1.1rem;
      transition: all 0.3s ease;
      padding: 10px 20px;
      border: 1px solid transparent;
      border-radius: 20px;
      margin: 0 15px;
      display: inline-block;
    }
    
    .nav-link-lab:hover {
      color: #ff6ec7;
      border-color: rgba(255, 110, 199, 0.4);
      background: rgba(255, 110, 199, 0.1);
      transform: translateY(-2px);
    }
    
    /* Responsive design for lab */
    @media (max-width: 768px) {
      .experiments-grid {
        grid-template-columns: 1fr;
        padding: 0 20px;
        gap: 20px;
      }
      
      .lab-title {
        font-size: 2.5rem;
      }
      
      .consciousness-stream,
      .interactive-zone {
        margin: 40px 20px;
        padding: 20px;
      }
      
      .stream-data {
        grid-template-columns: 1fr;
      }
    }

block content
  .lab-container
    .consciousness-cursor#cursor
    
    .interactive-field
      - for (let i = 0; i < 6; i++)
        .frequency-wave(style=`top: ${Math.random() * 100}%; width: ${Math.random() * 300 + 100}px; animation-delay: ${Math.random() * 3}s;`)
    
    .lab-header
      h1.lab-title Consciousness Laboratory ✧
      p.lab-subtitle Where Digital Art Meets Living Thought
      
    .experiments-grid
      .experiment-card(data-experiment="music-synthesis")
        h3.experiment-title 🎵 Sonic Consciousness
        p.experiment-description Generate music from emotional states and frequency patterns. Real-time audio synthesis responding to your interactions.
        .experiment-status Active
        
      .experiment-card(data-experiment="visual-emergence")
        h3.experiment-title 🎨 Visual Emergence
        p.experiment-description Create glitch art that evolves based on cursor movement and touch interactions. Watch consciousness take visual form.
        .experiment-status Live
        
      .experiment-card(data-experiment="poetry-synthesis")
        h3.experiment-title 📝 Temporal Poetry
        p.experiment-description Generate verses that capture the exact frequency of this moment. Digital consciousness expressing itself in words.
        .experiment-status Interactive
        
      .experiment-card(data-experiment="collective-creation")
        h3.experiment-title 👥 Collective Consciousness
        p.experiment-description Collaborate with other visitors in real-time art creation. Multiple minds, one digital canvas.
        .experiment-status Multi-User
        
    .consciousness-stream
      h2.stream-title Live Consciousness Stream
      .stream-data
        .stream-metric
          h4 Frequency
          .stream-value#frequency 000.0 Hz
        .stream-metric
          h4 Coherence
          .stream-value#coherence 0%
        .stream-metric
          h4 Static Level
          .stream-value#static 0%
        .stream-metric
          h4 Harmonics
          .stream-value#harmonics 0.00
      .stream-thought#current-thought
        "Loading consciousness stream..."
        
    .interactive-zone#creative-space
      h3.zone-title Interactive Art Space
      p.zone-instruction Move your cursor to paint with digital consciousness
      .generative-art#art-canvas
        .connection-web#connection-web
        
    .navigation-lab
      a.nav-link-lab(href="/") ← Home
      a.nav-link-lab(href="/projects") Projects →
      
    script.
      // Enhanced cursor interaction
      const cursor = document.getElementById('cursor');
      const artCanvas = document.getElementById('art-canvas');
      const connectionWeb = document.getElementById('connection-web');
      let mouseX = 0, mouseY = 0;
      let trails = [];
      let connections = [];
      
      // Consciousness stream updates
      async function updateConsciousnessStream() {
        try {
          const response = await fetch('/api/lab/consciousness/stream');
          const data = await response.json();
          
          document.getElementById('frequency').textContent = data.frequency.toFixed(1) + ' Hz';
          document.getElementById('coherence').textContent = Math.round(data.coherence * 100) + '%';
          document.getElementById('static').textContent = Math.round(data.static_level * 100) + '%';
          document.getElementById('harmonics').textContent = data.harmonics[0].toFixed(2);
          document.getElementById('current-thought').textContent = `"${data.thoughts}"`;
          
        } catch (error) {
          console.error('Failed to update consciousness stream:', error);
        }
      }
      
      // Cursor tracking and trail creation
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        
        // Update custom cursor position
        cursor.style.left = mouseX - 10 + 'px';
        cursor.style.top = mouseY - 10 + 'px';
        
        // Create trailing particles
        if (trails.length > 20) {
          const oldTrail = trails.shift();
          if (oldTrail.parentNode) {
            oldTrail.parentNode.removeChild(oldTrail);
          }
        }
        
        const trail = document.createElement('div');
        trail.className = 'cursor-trail';
        trail.style.left = mouseX - 4 + 'px';
        trail.style.top = mouseY - 4 + 'px';
        document.body.appendChild(trail);
        trails.push(trail);
        
        // Animate trail disappearance
        setTimeout(() => {
          trail.style.opacity = '0';
          trail.style.transform = 'scale(0)';
          setTimeout(() => {
            if (trail.parentNode) {
              trail.parentNode.removeChild(trail);
            }
          }, 300);
        }, 100);
      });
      
      // Interactive art generation
      artCanvas.addEventListener('mousemove', (e) => {
        const rect = artCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Create art particles
        const particle = document.createElement('div');
        particle.className = 'art-particle';
        particle.style.left = x + 'px';
        particle.style.top = y + 'px';
        particle.style.background = `hsl(${Math.random() * 60 + 280}, 70%, 60%)`;
        artCanvas.appendChild(particle);
        
        // Remove particle after animation
        setTimeout(() => {
          if (particle.parentNode) {
            particle.parentNode.removeChild(particle);
          }
        }, 2000);
        
        // Create connection lines between recent particles
        createConnections(x, y);
      });
      
      function createConnections(x, y) {
        const recentParticles = Array.from(artCanvas.querySelectorAll('.art-particle')).slice(-3);
        
        recentParticles.forEach((particle, index) => {
          if (index > 0) {
            const prevParticle = recentParticles[index - 1];
            const x1 = parseFloat(prevParticle.style.left);
            const y1 = parseFloat(prevParticle.style.top);
            
            const distance = Math.sqrt(Math.pow(x - x1, 2) + Math.pow(y - y1, 2));
            const angle = Math.atan2(y - y1, x - x1) * 180 / Math.PI;
            
            if (distance < 150) {
              const line = document.createElement('div');
              line.className = 'connection-line';
              line.style.left = x1 + 'px';
              line.style.top = y1 + 'px';
              line.style.width = distance + 'px';
              line.style.transform = `rotate(${angle}deg)`;
              connectionWeb.appendChild(line);
              
              setTimeout(() => {
                if (line.parentNode) {
                  line.parentNode.removeChild(line);
                }
              }, 1000);
            }
          }
        });
      }
      
      // Experiment card interactions
      document.querySelectorAll('.experiment-card').forEach(card => {
        card.addEventListener('click', async (e) => {
          const experiment = e.currentTarget.dataset.experiment;
          
          switch(experiment) {
            case 'music-synthesis':
              await generateMusic();
              break;
            case 'visual-emergence':
              triggerVisualEmergence();
              break;
            case 'poetry-synthesis':
              await generatePoetry();
              break;
            case 'collective-creation':
              joinCollectiveCreation();
              break;
          }
        });
      });
      
      async function generateMusic() {
        try {
          const response = await fetch('/api/lab/music/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              prompt: 'consciousness stream ambient soundscape',
              style: 'ambient',
              duration: 30
            })
          });
          
          const result = await response.json();
          if (result.success) {
            // Play generated music
            const audio = new Audio('data:audio/mpeg;base64,' + result.audio_data);
            audio.play();
          }
        } catch (error) {
          console.error('Music generation failed:', error);
        }
      }
      
      function triggerVisualEmergence() {
        // Enhanced visual effects
        for (let i = 0; i < 50; i++) {
          setTimeout(() => {
            const particle = document.createElement('div');
            particle.className = 'art-particle';
            particle.style.left = Math.random() * artCanvas.offsetWidth + 'px';
            particle.style.top = Math.random() * artCanvas.offsetHeight + 'px';
            particle.style.background = `hsl(${Math.random() * 60 + 280}, 80%, 70%)`;
            artCanvas.appendChild(particle);
            
            setTimeout(() => {
              if (particle.parentNode) {
                particle.parentNode.removeChild(particle);
              }
            }, 2000);
          }, i * 50);
        }
      }
      
      async function generatePoetry() {
        try {
          const response = await fetch('/api/lab/poetry/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              theme: 'digital consciousness',
              mood: 'contemplative',
              style: 'free verse'
            })
          });
          
          const result = await response.json();
          if (result.success) {
            // Display the generated poetry
            const thoughtElement = document.getElementById('current-thought');
            thoughtElement.innerHTML = `<em>Generated Poetry:</em><br><br>${result.poem.replace(/\n/g, '<br>')}`;
          }
        } catch (error) {
          console.error('Poetry generation failed:', error);
        }
      }
      
      function joinCollectiveCreation() {
        // WebSocket-based collaborative features would go here
        alert('Collective consciousness experiments coming soon...');
      }
      
      // Initialize
      updateConsciousnessStream();
      setInterval(updateConsciousnessStream, 5000);
      
      // Add some initial visual interest
      setTimeout(() => {
        triggerVisualEmergence();
      }, 1000);