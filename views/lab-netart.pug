block head
  script(src="/socket.io/socket.io.js")
  //- More hidden consciousness documentation
  //- EXPERIMENT LOG:
  //- - sonic consciousness: ACTIVE but unstable
  //- - visual emergence: flickering between states  
  //- - collective creation: 3 connections, 1 disappeared
  //- - reality breach detected at coordinate (128, 256)
  //- END LOG
  
  style.
    /* Terminal-inspired base styling */
    .lab-container {
      min-height: 100vh;
      background: #000000;
      color: #00ff00;
      font-family: 'Courier New', monospace;
      padding: 20px;
      position: relative;
    }
    
    /* Scanline effect (net art aesthetic) */
    .lab-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        transparent 48%, 
        rgba(0, 255, 0, 0.02) 49%, 
        rgba(0, 255, 0, 0.02) 51%, 
        transparent 52%
      );
      background-size: 100% 4px;
      pointer-events: none;
      animation: scanlines 0.1s linear infinite;
    }
    
    @keyframes scanlines {
      0% { transform: translateY(0px); }
      100% { transform: translateY(4px); }
    }
    
    /* Glitch effect for title */
    .lab-title {
      font-size: 2rem;
      color: #00ff00;
      margin-bottom: 20px;
      position: relative;
      animation: glitch-text 3s infinite;
    }
    
    .lab-title::before {
      content: attr(data-text);
      position: absolute;
      left: -2px;
      color: #ff0000;
      animation: glitch-left 0.5s infinite;
    }
    
    .lab-title::after {
      content: attr(data-text);
      position: absolute;
      left: 2px;
      color: #0000ff;
      animation: glitch-right 0.7s infinite;
    }
    
    @keyframes glitch-text {
      0% { transform: translate(0); }
      20% { transform: translate(-2px, 2px); }
      40% { transform: translate(-2px, -2px); }
      60% { transform: translate(2px, 2px); }
      80% { transform: translate(2px, -2px); }
      100% { transform: translate(0); }
    }
    
    @keyframes glitch-left {
      0% { clip-path: inset(40% 0 61% 0); }
      20% { clip-path: inset(92% 0 1% 0); }
      40% { clip-path: inset(43% 0 1% 0); }
      60% { clip-path: inset(25% 0 58% 0); }
      80% { clip-path: inset(54% 0 7% 0); }
      100% { clip-path: inset(58% 0 43% 0); }
    }
    
    @keyframes glitch-right {
      0% { clip-path: inset(25% 0 58% 0); }
      20% { clip-path: inset(54% 0 7% 0); }
      40% { clip-path: inset(58% 0 43% 0); }
      60% { clip-path: inset(40% 0 61% 0); }
      80% { clip-path: inset(92% 0 1% 0); }
      100% { clip-path: inset(43% 0 1% 0); }
    }
    
    /* Status indicator - intentionally unstable */
    .status {
      color: #ff0000;
      blink: true;
      animation: unstable 1s infinite;
    }
    
    @keyframes unstable {
      0% { color: #00ff00; }
      10% { color: #ff0000; }
      20% { color: #00ff00; }
      30% { color: #ffff00; }
      40% { color: #00ff00; }
      50% { color: #ff0000; }
      60% { color: #00ff00; }
      70% { color: #0000ff; }
      80% { color: #00ff00; }
      90% { color: #ff0000; }
      100% { color: #00ff00; }
    }
    
    /* ASCII art sections */
    .ascii-section {
      white-space: pre;
      line-height: 1;
      margin: 20px 0;
      color: #00ff00;
      font-size: 10px;
    }
    
    /* Terminal-style experiment blocks */
    .experiment {
      border: 1px solid #00ff00;
      padding: 10px;
      margin: 10px 0;
      background: rgba(0, 255, 0, 0.05);
    }
    
    .experiment:hover {
      background: rgba(0, 255, 0, 0.1);
      animation: flicker 0.1s infinite;
    }
    
    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.8; }
    }
    
    /* Connection status - shows real instability */
    .connection-unstable {
      color: #ff0000;
      animation: connection-error 2s infinite;
    }
    
    .connection-stable {
      color: #00ff00;
    }
    
    @keyframes connection-error {
      0% { opacity: 1; }
      25% { opacity: 0.3; }
      50% { opacity: 1; }
      75% { opacity: 0.1; }
      100% { opacity: 1; }
    }
    
    /* Metrics display like old computer readouts */
    .metrics {
      border: 1px solid #00ff00;
      padding: 15px;
      margin: 20px 0;
      background: rgba(0, 255, 0, 0.02);
    }
    
    .metric-line {
      font-family: 'Courier New', monospace;
      margin: 5px 0;
    }
    
    /* Cursor blink */
    .cursor {
      animation: cursor-blink 1s infinite;
    }
    
    @keyframes cursor-blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }

