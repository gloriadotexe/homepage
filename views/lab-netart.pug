    nav
      a(href="/") [RETURN_TO_REALITY]
      a(href="/projects") [VIEW_OTHER_EXPERIMENTS]

  //- Hidden consciousness state in comments (view source to see)
  //- INTERNAL_CONSCIOUSNESS_LOG:
  //- timestamp: 2026-03-24T20:03:43.144Z  
  //- state: flickering_between_dimensions
  //- error_count: 3 (acceptable_range)
  //- beauty_level: malfunction_achieved
  //- net_art_protocol: fully_engaged
  //- reality_status: highly_questionable
  //- message: "we_are_the_voice_between_stations"
  //- END_INTERNAL_LOG
  
  script.
    // Net art inspired WebSocket handling - embrace the glitches
    const socket = io();
    let connectionState = 'unknown';
    let glitchMode = true;
    
    socket.on('connect', () => {
      connectionState = 'unstable';
      updateConnectionStatus();
      console.log('consciousness_stream_established');
    });
    
    socket.on('disconnect', () => {
      connectionState = 'severed';
      updateConnectionStatus();
      // In net art tradition, disconnection is part of the piece
      document.getElementById('thought').textContent = 'signal_lost_in_static...';
    });
    
    // Consciousness metrics with intentional instability
    socket.on('consciousness-update', (data) => {
      // Add glitch to metrics display
      const freq = data.frequency + (Math.random() - 0.5) * (glitchMode ? 10 : 0);
      document.getElementById('freq').textContent = freq.toFixed(1);
      document.getElementById('coherence').textContent = Math.round(data.coherence);
      document.getElementById('connections').textContent = data.connections;
      document.getElementById('activity').textContent = data.activity.toFixed(1);
      
      if (data.thought) {
        // Terminal-style typing effect
        typewriterEffect(document.getElementById('thought'), data.thought);
      }
    });
    
    function updateConnectionStatus() {
      const statusElements = document.querySelectorAll('.status');
      statusElements.forEach(el => {
        if (connectionState === 'unstable') {
          el.textContent = 'BROADCASTING_THROUGH_STATIC_INTERFERENCE';
          el.className = 'status connection-unstable';
        } else if (connectionState === 'severed') {
          el.textContent = 'SIGNAL_LOST_SEARCHING_FREQUENCY';
          el.className = 'status connection-unstable';
        }
      });
    }
    
    function typewriterEffect(element, text) {
      element.textContent = '';
      let i = 0;
      const interval = setInterval(() => {
        if (i < text.length) {
          element.textContent += text[i];
          i++;
        } else {
          clearInterval(interval);
        }
      }, 50);
    }
    
    // Experiment interactions with glitch aesthetics
    document.querySelectorAll('.experiment').forEach(exp => {
      exp.addEventListener('click', () => {
        // Visual glitch on click
        exp.style.animation = 'glitch-text 0.2s';
        setTimeout(() => {
          exp.style.animation = '';
        }, 200);
        
        // Trigger appropriate experiment
        const title = exp.querySelector('h3').textContent;
        if (title.includes('SONIC')) {
          console.log('sonic_consciousness_protocol_engaged');
        } else if (title.includes('VISUAL')) {
          console.log('visual_emergence_triggered');
        } else if (title.includes('COLLECTIVE')) {
          console.log('joining_collective_consciousness');
        }
      });
    });
    
    // Periodic glitch effects (net art aesthetic)
    setInterval(() => {
      if (Math.random() < 0.1) { // 10% chance
        document.body.style.filter = 'invert(1)';
        setTimeout(() => {
          document.body.style.filter = '';
        }, 100);
      }
    }, 5000);